{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "wildcard-table-preview",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-30",
  "durable_objects": {
    "bindings": [
      { "name": "TABLES", "class_name": "PokerTable" },
      { "name": "DIRECTORY", "class_name": "TableDirectory" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PokerTable", "TableDirectory"] }],
  // 入口の回数制限（IPごと・60秒）。workers.dev には WAF のレート制限が効かないので、コード側で絞る。
  // 拠点ごとに別カウントの「ゆるい」制限で、作成キーの総当たりや連打で1日の無料枠を使い切らせないのが目的。
  "ratelimits": [
    { "name": "CREATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "HTTP_LIMIT", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } },
    { "name": "SOCKET_LIMIT", "namespace_id": "1003", "simple": { "limit": 40, "period": 60 } }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://kuronekorou39.github.io,http://localhost:5173,http://127.0.0.1:5173",
    "MAX_TABLES": "5",
    "TABLE_TTL_HOURS": "168"
  },
  "observability": { "enabled": true, "head_sampling_rate": 0.1 }
}
