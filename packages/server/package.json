{
  "name": "@wildcard/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "wrangler dev --local --ip 127.0.0.1 --port 8787 --var CREATE_KEY:local-preview-only",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "wrangler deploy --dry-run --outdir dist",
    "verify": "node scripts/verify.mjs",
    "soak": "node scripts/soak.mjs"
  },
  "dependencies": { "@wildcard/engine": "*", "@wildcard/table": "*" },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261022.1",
    "esbuild": "0.28.2",
    "miniflare": "4.20260730.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "wrangler": "4.152.0"
  }
}
